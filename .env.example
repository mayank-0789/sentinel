# SigNoz (host-facing; the sentinel container overrides these to host.docker.internal)
SIGNOZ_URL=http://localhost:8080
SIGNOZ_QUERY_API_URL=http://localhost:8080/api/v3
SIGNOZ_API_KEY=                        # SigNoz -> Settings -> API Keys (required for the query API)
MCP_URL=http://localhost:8000

# Anthropic — leave blank to run the reasoner as an offline stub (no spend);
# set a real key to enable live Claude diagnosis.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

EVIDENCE_BACKEND=query_api             # query_api | mcp
FLAGD_CONFIG_PATH=./vendor/otel-demo/src/flagd/demo.flagd.json
DEMO_FLAG=cartFailure                  # stub-reasoner remediation target when keyless
AUDIT_DB_PATH=sentinel.db
OTLP_ENDPOINT=http://localhost:4317
